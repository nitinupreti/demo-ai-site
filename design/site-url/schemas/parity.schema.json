{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo-ai-site/aem-migration/parity.schema.json",
  "title": "Visual parity artifact",
  "description": "Produced only by design/site-url/tools/parity.mjs. No agent may author, edit, estimate or round these scores.",
  "type": "object",
  "required": ["schema_version", "tool", "threshold", "runner_revision", "source_url", "breakpoints", "results", "components", "summary", "status"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string" },
    "cycle": { "type": ["integer", "null"] },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "dependencies": { "type": "object" },
        "browser": { "type": "string" }
      }
    },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "runner_revision": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string" },
    "target_urls": { "type": "object" },
    "breakpoints": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "preflight": {
      "type": "object",
      "properties": {
        "environment_blocked": { "type": "boolean" },
        "checks": {
          "description": "One per breakpoint and target mode; each carries its own font_fallback.",
          "type": "array",
          "items": { "type": "object" }
        },
        "font_fallback": {
          "description": "Faces the source loaded that the target declared but could not load: a page-wide delivery defect.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "family": { "type": "string" }, "weight": { "type": "string" }, "style": { "type": "string" } }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "breakpoint", "mode", "status"],
        "additionalProperties": true,
        "properties": {
          "component_id": { "type": "string" },
          "breakpoint": { "type": "integer" },
          "mode": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "WITHHELD", "SKIPPED"] },
          "withheld_reason": { "type": ["string", "null"] },
          "matched_pixels": { "type": ["integer", "null"] },
          "differing_pixels": { "type": ["integer", "null"] },
          "total_pixels": { "type": ["integer", "null"] },
          "visual_match_ratio": { "type": ["number", "null"] },
          "visual_match_percent": { "type": ["number", "null"] },
          "source": { "type": "object" },
          "target": { "type": "object" },
          "side_by_side": { "type": ["string", "null"] },
          "diff_mask": { "type": ["string", "null"] },
          "deltas": {
            "type": "object",
            "properties": {
              "rendered_fonts": {
                "description": "Empty when both sides rasterised the same families; one delta otherwise. A hard gate.",
                "type": "array",
                "items": { "type": "object" }
              },
              "rendered_fonts_unmeasured": { "type": "boolean" },
              "playback": { "type": "array", "items": { "type": "object" } },
              "signature": {
                "type": "object",
                "properties": {
                  "matches_source": { "type": "boolean", "description": "False when the live source no longer shows what discovery froze." }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "status"],
        "additionalProperties": true,
        "properties": {
          "component_id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "WITHHELD", "SKIPPED"] },
          "min_ratio": { "type": ["number", "null"] },
          "owning_layer_hint": { "type": ["string", "null"] },
          "breakpoints": { "type": "object" }
        }
      }
    },
    "page_composite": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["components_total", "components_passed", "components_failed"],
      "additionalProperties": true,
      "properties": {
        "components_total": { "type": "integer" },
        "components_passed": { "type": "integer" },
        "components_failed": { "type": "integer" },
        "components_withheld": { "type": "integer" },
        "min_ratio": { "type": ["number", "null"] },
        "duration_seconds": { "type": "number" },
        "page_composite_scored": { "type": "boolean", "description": "False when the config set composite: false (early previews)." },
        "font_fallback": { "type": "integer" },
        "source_drift_rows": { "type": "integer" }
      }
    },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] }
  }
}
