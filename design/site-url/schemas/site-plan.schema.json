{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo-ai-site/aem-migration/site-plan.schema.json",
  "title": "Site plan",
  "description": "Written by the site-planner agent from catalog.json, validated by the orchestrator before any component is built. Names the components and which catalog groups each one renders; the orchestrator derives owned paths, resource types and placement from it.",
  "type": "object",
  "required": ["run_id", "catalog_fingerprint", "components"],
  "additionalProperties": true,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "catalog_fingerprint": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "role", "tier", "groups"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["chrome", "content"] },
          "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
          "reuse_target": { "type": ["string", "null"] },
          "authoring": { "type": "string", "enum": ["worker", "mapped"] },
          "groups": { "type": "array", "items": { "type": "string", "pattern": "^(g-[0-9]{3,}|c-[0-9]{2,})$" } },
          "units": { "type": "array", "items": { "type": "string", "pattern": "^p-[0-9]{3,}/inst-[0-9]{3,}$" } },
          "java": { "type": "boolean" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
