{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo-ai-site/aem-migration/run-state.schema.json",
  "title": "Run state",
  "description": "Owned exclusively by the launcher/orchestrator. Agents must never write this file.",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "created_at", "launcher", "inputs", "stages"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["INITIALIZED", "RUNNING", "COMPLETE", "FAIL", "BLOCKED", "INTERRUPTED", "DRY_RUN"]
    },
    "current_stage": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "started_at": { "type": ["string", "null"] },
    "ended_at": { "type": ["string", "null"] },
    "duration_seconds": { "type": ["number", "null"] },
    "target_url": { "type": ["string", "null"] },
    "launcher": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "agent": { "type": "string" },
        "agent_version": { "type": "string" },
        "working_directory": { "type": "string" }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["SITE_URL", "BREAKPOINTS", "EVIDENCE_DIR"],
      "additionalProperties": true,
      "properties": {
        "SITE_URL": { "type": "string" },
        "TARGET_PAGE_PATH": { "type": ["string", "null"] },
        "BREAKPOINTS": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
        "AEM_HOST": { "type": "string" },
        "AEM_PORT": { "type": "integer" },
        "VISUAL_PASS_RATIO": { "type": "number" },
        "EVIDENCE_DIR": { "type": "string" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "status"],
        "additionalProperties": true,
        "properties": {
          "stage": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "STARTED", "PASS", "FAIL", "BLOCKED", "COMPLETE"]
          },
          "message": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"] },
          "ended_at": { "type": ["string", "null"] },
          "duration_seconds": { "type": ["number", "null"] },
          "result_path": { "type": ["string", "null"] },
          "checks": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "timings": { "type": "object" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "stage": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["PENDING", "STARTED", "PASS", "FAIL", "BLOCKED", "COMPLETE"] },
          "started_at": { "type": ["string", "null"] },
          "ended_at": { "type": ["string", "null"] },
          "duration_seconds": { "type": ["number", "null"] },
          "activity": { "type": "integer" }
        }
      }
    },
    "events": { "type": "array", "items": { "type": "object" } },
    "stage_results": { "type": "object" }
  }
}
