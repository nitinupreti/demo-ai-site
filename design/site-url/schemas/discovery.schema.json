{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo-ai-site/aem-migration/discovery.schema.json",
  "title": "Source discovery artifact",
  "description": "Produced only by design/site-url/tools/discover.mjs. Machine-readable replacement for the Stage 1 prose tables, sliceable per component for agent fan-out.",
  "type": "object",
  "required": ["schema_version", "tool", "source", "breakpoints", "source_fingerprint", "readiness", "instances", "coverage", "status"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "dependencies": { "type": "object" },
        "browser": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["requested_url", "final_url"],
      "additionalProperties": true,
      "properties": {
        "requested_url": { "type": "string" },
        "final_url": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "breakpoints": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "dpr": { "type": "number" },
    "source_fingerprint": { "type": "string", "minLength": 1 },
    "readiness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["breakpoint", "status"],
        "additionalProperties": true,
        "properties": {
          "breakpoint": { "type": "integer" },
          "inner_width": { "type": "integer" },
          "dpr": { "type": "number" },
          "visual_viewport_scale": { "type": "number" },
          "fonts_ready": { "type": "boolean" },
          "fonts_checked": { "type": "array", "items": { "type": "object" } },
          "images": { "type": "object" },
          "media": { "type": "array", "items": { "type": "object" } },
          "max_rect_delta_px": { "type": "number" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "failures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "signals", "selector", "rect", "visibility_by_bp", "signature"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^inst-[0-9]{3,}$" },
          "order": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "signals": { "type": "array", "items": { "type": "integer" } },
          "selector": { "type": "object" },
          "rect": { "type": "object" },
          "visibility_by_bp": { "type": "object" },
          "signature": { "type": "object" },
          "styles": { "type": "object" },
          "media": { "type": "object" },
          "repeated_children": { "type": "object" },
          "content": {
            "description": "Per breakpoint: what the instance rendered, so a worker never re-scrapes the live page.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["tag", "text"],
                    "properties": {
                      "tag": { "type": "string" },
                      "text": { "type": "string" },
                      "level": { "type": "integer" },
                      "href": { "type": "string", "description": "Absolute." },
                      "html": { "type": "string", "description": "Inline markup only, links made absolute." }
                    }
                  }
                },
                "links": { "type": "array", "items": { "type": "object" } },
                "svgs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": { "type": "string", "description": "svg/<16 hex>.svg under the discovery directory, once externalized." },
                      "sha256": { "type": "string" },
                      "markup": { "type": "string", "description": "Present until externalized; computed paints written as attributes, sprite <use> inlined." },
                      "truncated": { "type": "boolean" },
                      "w": { "type": "number" },
                      "h": { "type": "number" },
                      "view_box": { "type": ["string", "null"] },
                      "aria_label": { "type": ["string", "null"] },
                      "title": { "type": ["string", "null"] },
                      "in_link": { "type": ["string", "null"] }
                    }
                  }
                },
                "backgrounds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": { "type": "string" },
                      "tag": { "type": "string" },
                      "w": { "type": "number" },
                      "h": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "coverage": { "type": "object" },
    "fonts": {
      "description": "Every @font-face the page declared, merged across breakpoints; the orchestrator delivers the loaded ones.",
      "type": "object",
      "properties": {
        "faces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["family", "src"],
            "properties": {
              "family": { "type": "string" },
              "weight": { "type": "string" },
              "style": { "type": "string" },
              "stretch": { "type": "string" },
              "unicode_range": { "type": ["string", "null"] },
              "display": { "type": ["string", "null"] },
              "src": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["url"],
                  "properties": { "url": { "type": "string" }, "format": { "type": ["string", "null"] } }
                }
              },
              "loaded": { "type": "boolean" }
            }
          }
        },
        "loaded": { "type": "array", "items": { "type": "object" } },
        "inaccessible_sheets": { "type": "array", "items": { "type": "string" } },
        "unresolved_sheets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "screenshots": { "type": "object" },
    "denominators": { "type": "object" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "failures": { "type": "array", "items": { "type": "string" } }
  }
}
