<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Footer"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured"
             sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured"
                  sling:resourceType="granite/ui/components/coral/foundation/tabs"
                  maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <about jcr:primaryType="nt:unstructured"
                           jcr:title="About"
                           sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                           margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <aboutHeading jcr:primaryType="nt:unstructured"
                                                  sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                  fieldLabel="About Heading"
                                                  required="{Boolean}true"
                                                  name="./aboutHeading"/>
                                    <aboutBody jcr:primaryType="nt:unstructured"
                                               sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                               fieldLabel="About Body"
                                               name="./aboutBody"
                                               useFixedInlineToolbar="{Boolean}true">
                                        <rtePlugins jcr:primaryType="nt:unstructured">
                                            <format jcr:primaryType="nt:unstructured" features="bold,italic"/>
                                            <links jcr:primaryType="nt:unstructured" features="modifylink,unlink"/>
                                        </rtePlugins>
                                    </aboutBody>
                                </items>
                            </column>
                        </items>
                    </about>
                    <instagram jcr:primaryType="nt:unstructured"
                               jcr:title="Instagram"
                               sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                               margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <instagramHeading jcr:primaryType="nt:unstructured"
                                                      sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                      fieldLabel="Instagram Heading"
                                                      name="./instagramHeading"/>
                                    <instagramItems jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldLabel="Instagram Tiles">
                                        <field jcr:primaryType="nt:unstructured"
                                               sling:resourceType="granite/ui/components/coral/foundation/container"
                                               name="./instagramItems">
                                            <items jcr:primaryType="nt:unstructured">
                                                <image jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                       fieldLabel="Image"
                                                       required="{Boolean}true"
                                                       rootPath="/content/dam"
                                                       name="./image"/>
                                                <imageAlt jcr:primaryType="nt:unstructured"
                                                          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                          fieldLabel="Image Alt Text"
                                                          name="./imageAlt"/>
                                                <link jcr:primaryType="nt:unstructured"
                                                      sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                      fieldLabel="Link URL"
                                                      name="./link"/>
                                            </items>
                                        </field>
                                    </instagramItems>
                                </items>
                            </column>
                        </items>
                    </instagram>
                    <social jcr:primaryType="nt:unstructured"
                            jcr:title="Follow Us"
                            sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <followHeading jcr:primaryType="nt:unstructured"
                                                   sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                   fieldLabel="Follow-Us Heading"
                                                   name="./followHeading"/>
                                    <socialItems jcr:primaryType="nt:unstructured"
                                                 sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                 composite="{Boolean}true"
                                                 fieldLabel="Social Links">
                                        <field jcr:primaryType="nt:unstructured"
                                               sling:resourceType="granite/ui/components/coral/foundation/container"
                                               name="./socialItems">
                                            <items jcr:primaryType="nt:unstructured">
                                                <network jcr:primaryType="nt:unstructured"
                                                         sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                         fieldLabel="Network"
                                                         name="./network">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <facebook jcr:primaryType="nt:unstructured" selected="{Boolean}true" text="Facebook" value="facebook"/>
                                                        <instagram jcr:primaryType="nt:unstructured" text="Instagram" value="instagram"/>
                                                        <twitter jcr:primaryType="nt:unstructured" text="Twitter / X" value="twitter"/>
                                                        <youtube jcr:primaryType="nt:unstructured" text="YouTube" value="youtube"/>
                                                        <linkedin jcr:primaryType="nt:unstructured" text="LinkedIn" value="linkedin"/>
                                                    </items>
                                                </network>
                                                <link jcr:primaryType="nt:unstructured"
                                                      sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                      fieldLabel="Profile URL"
                                                      name="./link"/>
                                                <label jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                       fieldLabel="Accessible Label"
                                                       fieldDescription="Screen-reader text, e.g. &quot;Follow us on Instagram&quot;. Defaults to the network name."
                                                       name="./label"/>
                                            </items>
                                        </field>
                                    </socialItems>
                                </items>
                            </column>
                        </items>
                    </social>
                    <style jcr:primaryType="nt:unstructured"
                           jcr:title="Style"
                           sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                           margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <style jcr:primaryType="nt:unstructured"
                                           sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                           fieldLabel="Design Style"
                                           name="./style">
                                        <items jcr:primaryType="nt:unstructured">
                                            <furniture jcr:primaryType="nt:unstructured" selected="{Boolean}true" text="Furniture" value="furniture"/>
                                        </items>
                                    </style>
                                </items>
                            </column>
                        </items>
                    </style>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
