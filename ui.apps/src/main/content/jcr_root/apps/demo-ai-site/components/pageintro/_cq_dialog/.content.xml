<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Page Intro"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <properties
                jcr:primaryType="nt:unstructured"
                jcr:title="Properties"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <inner
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <eyebrow
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Eyebrow"
                                fieldDescription="Small overline above the title."
                                name="./eyebrow"/>
                            <title
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Title"
                                required="{Boolean}true"
                                name="./title"/>
                            <ctaText
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="CTA Text"
                                name="./ctaText"/>
                            <ctaLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="CTA Link"
                                rootPath="/content"
                                name="./ctaLink"/>
                        </items>
                    </inner>
                </items>
            </properties>
            <style
                jcr:primaryType="nt:unstructured"
                jcr:title="Style"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <inner
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <alignment
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Alignment"
                                fieldDescription="Horizontal alignment of text within the container."
                                name="./alignment"
                                value="center">
                                <items jcr:primaryType="nt:unstructured">
                                    <center jcr:primaryType="nt:unstructured" text="Center (default)" value="center"/>
                                    <left jcr:primaryType="nt:unstructured" text="Left" value="left"/>
                                    <right jcr:primaryType="nt:unstructured" text="Right" value="right"/>
                                </items>
                            </alignment>
                            <sectionPadding
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Section Padding"
                                fieldDescription="Vertical padding above and below the intro block."
                                name="./sectionPadding"
                                value="md">
                                <items jcr:primaryType="nt:unstructured">
                                    <none jcr:primaryType="nt:unstructured" text="None" value="none"/>
                                    <sm jcr:primaryType="nt:unstructured" text="Small" value="sm"/>
                                    <md jcr:primaryType="nt:unstructured" text="Medium (default)" value="md"/>
                                    <lg jcr:primaryType="nt:unstructured" text="Large" value="lg"/>
                                </items>
                            </sectionPadding>
                            <backgroundColor
                                granite:class="cq-dialog-dropdown-showhide"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Background Color"
                                name="./backgroundColor"
                                value="cream">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    cq-dialog-dropdown-showhide-target=".cmp-pageintro__hex-showhide"/>
                                <items jcr:primaryType="nt:unstructured">
                                    <cream jcr:primaryType="nt:unstructured" text="Cream (default)" value="cream"/>
                                    <white jcr:primaryType="nt:unstructured" text="White" value="white"/>
                                    <other jcr:primaryType="nt:unstructured" text="Other (custom hex)" value="other"/>
                                </items>
                            </backgroundColor>
                            <hexColor
                                granite:class="cmp-pageintro__hex-showhide hide"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Custom Background (hex)"
                                name="./hexColor">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showhidetargetvalue="other"/>
                            </hexColor>
                        </items>
                    </inner>
                </items>
            </style>
        </items>
    </content>
</jcr:root>
