<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Hero"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Properties"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <tagline
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Tagline"
                                        fieldDescription="Short eyebrow line above the heading. Used by Default and Furniture styles; ignored by Insights."
                                        name="./tagline"/>
                                    <heading
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                        fieldLabel="Heading"
                                        fieldDescription="Wrap the emphasized word in &lt;span class=&quot;cmp-hero__heading-highlight&quot;&gt;…&lt;/span&gt; to render the underline decoration."
                                        name="./heading"
                                        useFixedInlineToolbar="{Boolean}true">
                                        <rtePlugins jcr:primaryType="nt:unstructured">
                                            <format
                                                jcr:primaryType="nt:unstructured"
                                                features="bold,italic"/>
                                            <sourceedit
                                                jcr:primaryType="nt:unstructured"
                                                features="*"/>
                                        </rtePlugins>
                                        <uiSettings jcr:primaryType="nt:unstructured">
                                            <cui jcr:primaryType="nt:unstructured">
                                                <inline
                                                    jcr:primaryType="nt:unstructured"
                                                    toolbar="[format#bold,format#italic,#sourceedit]"/>
                                                <fullscreen
                                                    jcr:primaryType="nt:unstructured"
                                                    toolbar="[format#bold,format#italic,#sourceedit]"/>
                                            </cui>
                                        </uiSettings>
                                    </heading>
                                    <description
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                        fieldLabel="Description"
                                        name="./description"
                                        useFixedInlineToolbar="{Boolean}true">
                                        <rtePlugins jcr:primaryType="nt:unstructured">
                                            <format
                                                jcr:primaryType="nt:unstructured"
                                                features="bold,italic"/>
                                            <links
                                                jcr:primaryType="nt:unstructured"
                                                features="modifylink,unlink"/>
                                        </rtePlugins>
                                    </description>
                                    <ctaLabel
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Primary CTA Label"
                                        name="./ctaLabel"/>
                                    <ctaLink
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Primary CTA Link"
                                        name="./ctaLink"
                                        rootPath="/content"/>
                                    <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image"
                                        fieldDescription="DAM path. Portrait for Default, illustration for Insights. Ignored by Furniture (use Background Image instead)."
                                        name="./image"
                                        rootPath="/content/dam"/>
                                    <imageAlt
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Image Alt Text"
                                        name="./imageAlt"/>
                                    <travelFields
                                        granite:class="cmp-hero__style-showhide foundation-layout-util-vmargin"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <granite:data
                                            jcr:primaryType="nt:unstructured"
                                            showhidetargetvalue="default"/>
                                        <items jcr:primaryType="nt:unstructured">
                                            <playLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Play-Demo Label"
                                                fieldDescription="Secondary CTA next to the primary button (Default style only)."
                                                name="./playLabel"/>
                                            <playLink
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Play-Demo Link"
                                                name="./playLink"
                                                rootPath="/content"/>
                                        </items>
                                    </travelFields>
                                    <furnitureFields
                                        granite:class="cmp-hero__style-showhide foundation-layout-util-vmargin"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <granite:data
                                            jcr:primaryType="nt:unstructured"
                                            showhidetargetvalue="furniture"/>
                                        <items jcr:primaryType="nt:unstructured">
                                            <backgroundImage
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Background Image"
                                                fieldDescription="Full-bleed background image behind the hero card (Furniture style only)."
                                                name="./backgroundImage"
                                                rootPath="/content/dam"/>
                                            <backgroundImageAlt
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Background Image Alt Text"
                                                name="./backgroundImageAlt"/>
                                        </items>
                                    </furnitureFields>
                                </items>
                            </column>
                        </items>
                    </properties>
                    <style
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Style"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <style
                                        granite:class="cq-dialog-dropdown-showhide"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        fieldLabel="Design Style"
                                        fieldDescription="Visual theme applied to the hero. Style-specific fields on the Properties tab and below are shown/hidden based on this selection."
                                        name="./style">
                                        <items jcr:primaryType="nt:unstructured">
                                            <default
                                                jcr:primaryType="nt:unstructured"
                                                selected="{Boolean}true"
                                                text="Default (Travel)"
                                                value="default"/>
                                            <furniture
                                                jcr:primaryType="nt:unstructured"
                                                text="Furniture"
                                                value="furniture"/>
                                            <insights
                                                jcr:primaryType="nt:unstructured"
                                                text="Insights (Split + Illustration)"
                                                value="insights"/>
                                        </items>
                                        <granite:data
                                            jcr:primaryType="nt:unstructured"
                                            cq-dialog-dropdown-showhide-target=".cmp-hero__style-showhide"/>
                                    </style>
                                    <travelStyleFields
                                        granite:class="cmp-hero__style-showhide foundation-layout-util-vmargin"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <granite:data
                                            jcr:primaryType="nt:unstructured"
                                            showhidetargetvalue="default"/>
                                        <items jcr:primaryType="nt:unstructured">
                                            <showDecorations
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Show the cream ellipse background blob and floating plane decorations (Default style only)."
                                                name="./showDecorations"
                                                text="Show decorations"
                                                value="{Boolean}true"
                                                uncheckedValue="{Boolean}false"
                                                checked="{Boolean}true"/>
                                        </items>
                                    </travelStyleFields>
                                    <background
                                        granite:class="cq-dialog-dropdown-showhide"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        fieldLabel="Background Color"
                                        name="./background">
                                        <items jcr:primaryType="nt:unstructured">
                                            <default
                                                jcr:primaryType="nt:unstructured"
                                                selected="{Boolean}true"
                                                text="Default (theme)"
                                                value=""/>
                                            <white
                                                jcr:primaryType="nt:unstructured"
                                                text="White"
                                                value="white"/>
                                            <cream
                                                jcr:primaryType="nt:unstructured"
                                                text="Cream"
                                                value="cream"/>
                                            <other
                                                jcr:primaryType="nt:unstructured"
                                                text="Other (custom hex)"
                                                value="other"/>
                                        </items>
                                        <granite:data
                                            jcr:primaryType="nt:unstructured"
                                            cq-dialog-dropdown-showhide-target=".cmp-hero__bg-other-showhide"/>
                                    </background>
                                    <backgroundOther
                                        granite:class="cmp-hero__bg-other-showhide foundation-layout-util-vmargin"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <granite:data
                                            jcr:primaryType="nt:unstructured"
                                            showhidetargetvalue="other"/>
                                        <items jcr:primaryType="nt:unstructured">
                                            <backgroundHex
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Custom Background Hex"
                                                fieldDescription="e.g. #FFF1DA"
                                                name="./backgroundHex"/>
                                        </items>
                                    </backgroundOther>
                                </items>
                            </column>
                        </items>
                    </style>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
