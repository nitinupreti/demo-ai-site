<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Icon Cards"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <properties
                jcr:primaryType="nt:unstructured"
                jcr:title="Properties"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <inner
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <titlePrefix
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Title Prefix"
                                fieldDescription="Optional leading words shown before the main title."
                                name="./titlePrefix"/>
                            <title
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Title"
                                required="{Boolean}true"
                                name="./title"/>
                            <description
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Description"
                                name="./description"/>
                            <items
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Cards"
                                name="./items">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./items">
                                    <items jcr:primaryType="nt:unstructured">
                                        <iconPath
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Icon Image"
                                            rootPath="/content/dam"
                                            name="./iconPath"/>
                                        <iconAlt
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Icon Alt"
                                            name="./iconAlt"/>
                                        <title
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Card Title"
                                            required="{Boolean}true"
                                            name="./title"/>
                                        <description
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                            fieldLabel="Card Description"
                                            name="./description"/>
                                    </items>
                                </field>
                            </items>
                        </items>
                    </inner>
                </items>
            </properties>
            <style
                jcr:primaryType="nt:unstructured"
                jcr:title="Style"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <inner
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Columns"
                                name="./columns"
                                value="3">
                                <items jcr:primaryType="nt:unstructured">
                                    <two jcr:primaryType="nt:unstructured" text="2" value="2"/>
                                    <three jcr:primaryType="nt:unstructured" text="3 (default)" value="3"/>
                                    <four jcr:primaryType="nt:unstructured" text="4" value="4"/>
                                </items>
                            </columns>
                            <sectionPadding
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Section Padding"
                                name="./sectionPadding"
                                value="lg">
                                <items jcr:primaryType="nt:unstructured">
                                    <none jcr:primaryType="nt:unstructured" text="None" value="none"/>
                                    <sm jcr:primaryType="nt:unstructured" text="Small" value="sm"/>
                                    <md jcr:primaryType="nt:unstructured" text="Medium" value="md"/>
                                    <lg jcr:primaryType="nt:unstructured" text="Large (default)" value="lg"/>
                                </items>
                            </sectionPadding>
                            <backgroundColor
                                granite:class="cq-dialog-dropdown-showhide"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Background Color"
                                name="./backgroundColor"
                                value="white">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    cq-dialog-dropdown-showhide-target=".cmp-iconcards__hex-showhide"/>
                                <items jcr:primaryType="nt:unstructured">
                                    <white jcr:primaryType="nt:unstructured" text="White (default)" value="white"/>
                                    <grey jcr:primaryType="nt:unstructured" text="Light Grey" value="grey"/>
                                    <other jcr:primaryType="nt:unstructured" text="Other (custom hex)" value="other"/>
                                </items>
                            </backgroundColor>
                            <hexColor
                                granite:class="cmp-iconcards__hex-showhide hide"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Custom Background (hex)"
                                name="./hexColor">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showhidetargetvalue="other"/>
                            </hexColor>
                        </items>
                    </inner>
                </items>
            </style>
        </items>
    </content>
</jcr:root>
