<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="TOTC Course Carousel"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/tabs" maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties jcr:primaryType="nt:unstructured" jcr:title="Properties" sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <categoryLabel jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Category Label" name="./categoryLabel" required="{Boolean}true"/>
                                            <categoryIcon jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Category Icon" name="./categoryIcon" value="palette">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <palette jcr:primaryType="nt:unstructured" text="Palette" value="palette"/>
                                                    <globe jcr:primaryType="nt:unstructured" text="Globe" value="globe"/>
                                                    <ribbon jcr:primaryType="nt:unstructured" text="Ribbon" value="ribbon"/>
                                                </items>
                                            </categoryIcon>
                                            <seeAllLabel jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="See All Label" name="./seeAllLabel" value="SEE ALL"/>
                                            <seeAllLink jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/pathfield" fieldLabel="See All Link" name="./seeAllLink" rootPath="/content"/>
                                            <featuredTitle jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Featured Card Title" name="./featuredTitle"/>
                                            <featuredSubtitle jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textarea" fieldLabel="Featured Card Description" name="./featuredSubtitle"/>
                                            <featuredImage jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/pathfield" fieldLabel="Featured Card Image" name="./featuredImage" rootPath="/content/dam"/>
                                            <featuredPrice jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Featured Price" name="./featuredPrice"/>
                                            <featuredCta jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Featured CTA Label" name="./featuredCta" value="EXPLORE"/>
                                            <featuredPosition jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/numberfield" fieldLabel="Featured Card Position (index)" fieldDescription="0-based index of the book card to replace with the featured detail card. Default 6." name="./featuredPosition" value="6" min="{Long}0"/>
                                            <books jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/multifield" fieldLabel="Book Cards" composite="{Boolean}true">
                                                <field jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/container" name="./books">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <title jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Book Title" name="./title"/>
                                                        <color jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Spine Color" name="./color" value="orange">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <orange jcr:primaryType="nt:unstructured" text="Orange" value="orange"/>
                                                                <yellow jcr:primaryType="nt:unstructured" text="Yellow" value="yellow"/>
                                                                <green jcr:primaryType="nt:unstructured" text="Green" value="green"/>
                                                                <lightGreen jcr:primaryType="nt:unstructured" text="Light green" value="lightGreen"/>
                                                                <lilac jcr:primaryType="nt:unstructured" text="Lilac" value="lilac"/>
                                                                <blue jcr:primaryType="nt:unstructured" text="Blue" value="blue"/>
                                                                <pink jcr:primaryType="nt:unstructured" text="Pink" value="pink"/>
                                                            </items>
                                                        </color>
                                                    </items>
                                                </field>
                                            </books>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
