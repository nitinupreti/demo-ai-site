<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Services Grid"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <columns
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <column
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <cards
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Service cards"
                                fieldDescription="Add one entry per service card. The design shows six cards laid out 2 per row."
                                composite="{Boolean}true">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./cards">
                                    <items jcr:primaryType="nt:unstructured">
                                        <titleTop
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Title — top line"
                                            name="./titleTop"/>
                                        <titleBottom
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Title — bottom line"
                                            name="./titleBottom"/>
                                        <illustration
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Illustration image"
                                            name="./illustration"
                                            rootPath="/content/dam"/>
                                        <illustrationAlt
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Illustration alt text"
                                            name="./illustrationAlt"/>
                                        <linkText
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Link text"
                                            name="./linkText"/>
                                        <linkPath
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Link destination"
                                            name="./linkPath"
                                            rootPath="/content"/>
                                        <variant
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                            fieldLabel="Card color"
                                            fieldDescription="Grey = light card w/ green highlight, Green = green card, Dark = dark card w/ green title."
                                            name="./variant">
                                            <items jcr:primaryType="nt:unstructured">
                                                <grey jcr:primaryType="nt:unstructured" text="Grey" value="grey" selected="{Boolean}true"/>
                                                <green jcr:primaryType="nt:unstructured" text="Green" value="green"/>
                                                <dark jcr:primaryType="nt:unstructured" text="Dark" value="dark"/>
                                            </items>
                                        </variant>
                                    </items>
                                </field>
                            </cards>
                        </items>
                    </column>
                </items>
            </columns>
        </items>
    </content>
</jcr:root>
