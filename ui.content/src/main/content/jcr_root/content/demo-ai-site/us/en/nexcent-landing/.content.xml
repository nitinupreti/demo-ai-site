                        <socialLinks jcr:primaryType="nt:unstructured">
                            <item0 jcr:primaryType="nt:unstructured" platform="facebook" url="https://facebook.com/nexcent"/>
                            <item1 jcr:primaryType="nt:unstructured" platform="instagram" url="https://instagram.com/nexcent"/>
                            <item2 jcr:primaryType="nt:unstructured" platform="tiktok" url="https://tiktok.com/@nexcent"/>
                        </socialLinks>
