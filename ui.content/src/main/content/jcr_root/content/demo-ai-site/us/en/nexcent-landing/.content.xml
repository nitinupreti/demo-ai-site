                        authorRole="British Dragon Boat Racing Association"
                        imagePath="/content/dam/demo-ai-site/asset.jpg"
                        imageAlt="Tim Smith at an event"
                        linkText="Meet all customers"
                        linkUrl="#customers"
                        sectionPadding="md"
                        backgroundColor="white">
                        <logos jcr:primaryType="nt:unstructured">
                            <logo0 jcr:primaryType="nt:unstructured" imagePath="/content/dam/demo-ai-site/asset.jpg" imageAlt="Customer 1"/>
                            <logo1 jcr:primaryType="nt:unstructured" imagePath="/content/dam/demo-ai-site/asset.jpg" imageAlt="Customer 2"/>
                            <logo2 jcr:primaryType="nt:unstructured" imagePath="/content/dam/demo-ai-site/asset.jpg" imageAlt="Customer 3"/>
                            <logo3 jcr:primaryType="nt:unstructured" imagePath="/content/dam/demo-ai-site/asset.jpg" imageAlt="Customer 4"/>
                            <logo4 jcr:primaryType="nt:unstructured" imagePath="/content/dam/demo-ai-site/asset.jpg" imageAlt="Customer 5"/>
                            <logo5 jcr:primaryType="nt:unstructured" imagePath="/content/dam/demo-ai-site/asset.jpg" imageAlt="Customer 6"/>
                        </logos>
                    </testimonial>
                    <blog
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="demo-ai-site/components/bloglist"
