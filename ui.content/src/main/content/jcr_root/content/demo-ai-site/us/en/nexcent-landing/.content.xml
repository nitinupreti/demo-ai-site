                        ctaLink="#footer-tips"
                        imagePath="/content/dam/demo-ai-site/asset.jpg"
                        imageAlt="Mobile design illustration"
                        imagePosition="left"
                        sectionPadding="md"
                        backgroundColor="white"/>
