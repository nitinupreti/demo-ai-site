<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/demo-ai-site/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="demo-ai-site/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="demo-ai-site/components/container"
            layout="simple">
            <site-header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="demo-ai-site/components/site-header"
                logoText="Notion"
                logoHref="https://www.notion.com/product"
                menuLabel="Open menu"
                ctaLabel="Get Notion free"
                ctaHref="https://www.notion.com/signup"
                secondaryLabel="Log in"
                secondaryHref="https://www.notion.com/login">
                <navItems jcr:primaryType="nt:unstructured">
                    <item0 jcr:primaryType="nt:unstructured" label="Product⌄" href="https://www.notion.com/product"/>
                    <item1 jcr:primaryType="nt:unstructured" label="AI⌄" href="https://www.notion.com/product/ai"/>
                    <item2 jcr:primaryType="nt:unstructured" label="Resources⌄" href="https://www.notion.com/resources"/>
                    <item3 jcr:primaryType="nt:unstructured" label="Developers" href="https://developers.notion.com"/>
                    <item4 jcr:primaryType="nt:unstructured" label="Startups" href="https://www.notion.com/startups"/>
                    <item5 jcr:primaryType="nt:unstructured" label="Enterprise" href="https://www.notion.com/enterprise"/>
                    <item6 jcr:primaryType="nt:unstructured" label="Pricing" href="https://www.notion.com/pricing"/>
                    <item7 jcr:primaryType="nt:unstructured" label="Request a demo" href="https://www.notion.com/contact-sales"/>
                </navItems>
            </site-header>
        </root>
    </jcr:content>
</jcr:root>
