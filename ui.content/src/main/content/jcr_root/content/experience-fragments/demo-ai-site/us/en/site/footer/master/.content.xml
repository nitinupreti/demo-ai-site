<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/demo-ai-site/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer"
        sling:resourceType="demo-ai-site/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="demo-ai-site/components/container"
            layout="simple">
            <site-footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="demo-ai-site/components/site-footer"
                brandLabel="Notion"
                logoPath="/content/dam/demo-ai-site/design/notion-wordmark.svg"
                brandHref="https://www.notion.com/product"
                quoteText="We shape our tools, and thereafter our tools shape us."
                quoteAttribution="Marshall McLuhan"
                copyright="© 2026 Notion Labs, Inc."
                cookieLabel="Cookie settings"
                cookieHref="https://www.notion.com/trust/privacy-policy"
                languageLabel="English (US)">
                <linkGroups jcr:primaryType="nt:unstructured">
                    <g0 jcr:primaryType="nt:unstructured" heading="Product">
                        <links jcr:primaryType="nt:unstructured">
                            <l0 jcr:primaryType="nt:unstructured" label="Features" href="https://www.notion.com/product/features"/>
                            <l1 jcr:primaryType="nt:unstructured" label="What's New" href="https://www.notion.com/releases"/>
                            <l2 jcr:primaryType="nt:unstructured" label="Notion AI" href="https://www.notion.com/product/ai"/>
                            <l3 jcr:primaryType="nt:unstructured" label="Pricing" href="https://www.notion.com/pricing"/>
                            <l4 jcr:primaryType="nt:unstructured" label="Request a demo" href="https://www.notion.com/contact-sales"/>
                            <l5 jcr:primaryType="nt:unstructured" label="Download" href="https://www.notion.com/download"/>
                            <l6 jcr:primaryType="nt:unstructured" label="Explore more →" href="https://www.notion.com/explore"/>
                        </links>
                    </g0>
                    <g1 jcr:primaryType="nt:unstructured" heading="Resources">
                        <links jcr:primaryType="nt:unstructured">
                            <l0 jcr:primaryType="nt:unstructured" label="Customer stories" href="https://www.notion.com/customers"/>
                            <l1 jcr:primaryType="nt:unstructured" label="Connections" href="https://www.notion.com/connections"/>
                            <l2 jcr:primaryType="nt:unstructured" label="Marketplace" href="https://www.notion.com/templates"/>
                            <l3 jcr:primaryType="nt:unstructured" label="Help Center" href="https://www.notion.com/help"/>
                            <l4 jcr:primaryType="nt:unstructured" label="Academy" href="https://academy.notion.com"/>
                            <l5 jcr:primaryType="nt:unstructured" label="Community" href="https://www.notion.com/community"/>
                        </links>
                    </g1>
                    <g2 jcr:primaryType="nt:unstructured" heading="Company">
                        <links jcr:primaryType="nt:unstructured">
                            <l0 jcr:primaryType="nt:unstructured" label="About us" href="https://www.notion.com/about"/>
                            <l1 jcr:primaryType="nt:unstructured" label="Careers" href="https://www.notion.com/careers"/>
                            <l2 jcr:primaryType="nt:unstructured" label="Security" href="https://www.notion.com/security"/>
                            <l3 jcr:primaryType="nt:unstructured" label="Status" href="https://www.notion-status.com"/>
                            <l4 jcr:primaryType="nt:unstructured" label="Terms &amp; privacy" href="https://www.notion.com/terms-and-privacy"/>
                            <l5 jcr:primaryType="nt:unstructured" label="Your privacy rights" href="https://www.notion.com/trust/privacy-policy#california"/>
                        </links>
                    </g2>
                    <g3 jcr:primaryType="nt:unstructured" heading="Notion for">
                        <links jcr:primaryType="nt:unstructured">
                            <l0 jcr:primaryType="nt:unstructured" label="Enterprise" href="https://www.notion.com/enterprise"/>
                            <l1 jcr:primaryType="nt:unstructured" label="Small businesses" href="https://www.notion.com/teams"/>
                            <l2 jcr:primaryType="nt:unstructured" label="Startups" href="https://www.notion.com/startups"/>
                            <l3 jcr:primaryType="nt:unstructured" label="Developers" href="https://developers.notion.com"/>
                        </links>
                    </g3>
                </linkGroups>
            </site-footer>
        </root>
    </jcr:content>
</jcr:root>
