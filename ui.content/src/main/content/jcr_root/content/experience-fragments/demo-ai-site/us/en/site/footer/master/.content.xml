<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/demo-ai-site/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer"
        sling:resourceType="demo-ai-site/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="demo-ai-site/components/container"
            layout="simple">
            <ogsfooter
                jcr:primaryType="nt:unstructured"
                sling:resourceType="demo-ai-site/components/ogs-site-footer"
                brandTagline="A unit of Omnicom"
                quickLinksTitle="Quick Links"
                socialTitle="Stay in touch"
                copyrightText="© 2026 OGS. All rights reserved.">
                <quickLinks jcr:primaryType="nt:unstructured">
                    <link0
                        jcr:primaryType="nt:unstructured"
                        label="Who we are"
                        link="/content/demo-ai-site/us/en/ogs.html#what-we-do"/>
                    <link1
                        jcr:primaryType="nt:unstructured"
                        label="Capabilities"
                        link="/content/demo-ai-site/us/en/ogs.html#expertise"/>
                    <link2
                        jcr:primaryType="nt:unstructured"
                        label="Leadership"
                        link="/content/demo-ai-site/us/en/ogs/life-at-ogs.html#leadership-section"/>
                    <link3
                        jcr:primaryType="nt:unstructured"
                        label="Omnicom"
                        link="https://www.omc.com/"/>
                </quickLinks>
                <socials jcr:primaryType="nt:unstructured">
                    <social0
                        jcr:primaryType="nt:unstructured"
                        label="LinkedIn"
                        icon="/content/dam/demo-ai-site/en/footer/linkedin.png"
                        link="https://in.linkedin.com/company/omnicomglobalsolutions"/>
                    <social1
                        jcr:primaryType="nt:unstructured"
                        label="Instagram"
                        icon="/content/dam/demo-ai-site/en/footer/instagram.png"
                        link="https://www.instagram.com/omnicom_global_solutions/"/>
                    <social2
                        jcr:primaryType="nt:unstructured"
                        label="Email"
                        icon="/content/dam/demo-ai-site/en/footer/email.png"
                        link="mailto:helloOGS@teamomnicom.com"/>
                </socials>
                <legalLinks jcr:primaryType="nt:unstructured">
                    <link0
                        jcr:primaryType="nt:unstructured"
                        label="Privacy notice"
                        link="https://www.omc.com/privacy-notice/"/>
                    <link1
                        jcr:primaryType="nt:unstructured"
                        label="Terms of use"
                        link="http://omc.com/terms-of-use/"/>
                </legalLinks>
            </ogsfooter>
        </root>
    </jcr:content>
</jcr:root>

